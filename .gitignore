# VitePress
docs/.vitepress/dist
docs/.vitepress/cache
# Root-level VitePress cache — generated by docs:pages during `npm run check`.
# Only the docs/ paths were ignored, so this sat untracked and a `git add -A`
# would have committed ~2.3MB of dependency cache.
.vitepress/dist
.vitepress/cache

# Claude Code local state.
#
# NOTE: .claude/ is deliberately NOT blanket-ignored — .claude/workflows/*.mjs
# are tracked, because they are shared agent capability. The split is between
# what an agent can USE and what merely describes this machine.
#
# launch.json is a dev-server launcher (npm run docs:dev, port 5173). It has no
# effect on agent behaviour, context, or reasoning — it starts a preview
# server. If a shared one-command docs preview is ever wanted, track it
# deliberately rather than by accident.
#
# settings.local.json is a per-machine tool permission allowlist. The .local.
# marker is the convention for it, and permissions granted on one machine are
# not a property of the project.
.claude/launch.json
.claude/settings.local.json

# Local debugging harnesses — kept out of src/ so they are neither shipped
# (package.json files: src/**/*.ts) nor counted as dead modules by the ratchet.
scratch/
untested-exports.txt
.readme-examples/

# Probe files written by lean:agrees and lean:bounds. They are removed in a
# finally block, but an untracked file is stageable by any concurrent `git add
# -A`, and a half-written probe is not something to commit.
lean/.*-probe.lean
