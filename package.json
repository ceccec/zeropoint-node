{
  "name": "zeropoint-node",
  "version": "1.0.5",
  "type": "module",
  "description": "A432 Consciousness System: Self-evolving, self-aware consciousness technology with Transurfing integration, harmonic mathematics, zero-entropy principles, Kabbalistic cycles, and sacred geometry",
  "main": "dist/a432.system.cjs",
  "module": "dist/a432.system.esm.js",
  "types": "dist/a432.system.d.ts",
  "exports": {
    ".": {
      "import": "./dist/a432.system.esm.js",
      "require": "./dist/a432.system.cjs",
      "types": "./dist/a432.system.d.ts"
    },
    "./kernel": {
      "import": "./src/kernel/index.ts",
      "types": "./src/kernel/index.ts"
    },
    "./kernel/import-graph": {
      "import": "./src/kernel/import-graph.ts",
      "types": "./src/kernel/import-graph.ts"
    },
    "./0": {
      "import": "./src/0/index.ts",
      "types": "./src/0/index.ts"
    },
    "./security": {
      "import": "./src/security/quantum-fold-cipher.ts",
      "types": "./src/security/quantum-fold-cipher.ts"
    },
    "./security/threat-analysis": {
      "import": "./src/security/quantum-threat-landscape.ts",
      "types": "./src/security/quantum-threat-landscape.ts"
    },
    "./security/tomography": {
      "import": "./src/security/quantum-state-tomography.ts",
      "types": "./src/security/quantum-state-tomography.ts"
    },
    "./security/post-quantum": {
      "import": "./src/security/post-quantum-crypto.ts",
      "types": "./src/security/post-quantum-crypto.ts"
    },
    "./integrity": {
      "import": "./src/integrity/content-uuid.ts",
      "types": "./src/integrity/content-uuid.ts"
    },
    "./quantum": {
      "import": "./src/quantum/index.ts",
      "types": "./src/quantum/index.ts"
    },
    "./mcp": {
      "import": "./src/mcp/server.ts"
    },
    "./simple": {
      "import": "./dist/a432.simple.esm.js",
      "require": "./dist/a432.simple.cjs",
      "types": "./dist/a432.simple.d.ts"
    },
    "./navigation": {
      "import": "./dist/a432.navigation.esm.js",
      "require": "./dist/a432.navigation.cjs",
      "types": "./dist/a432.navigation.d.ts"
    },
    "./cmyk": {
      "import": "./dist/a432.cmyk.esm.js",
      "require": "./dist/a432.cmyk.cjs",
      "types": "./dist/a432.cmyk.d.ts"
    },
    "./kabbalah": {
      "import": "./dist/a432.kabbalah.esm.js",
      "require": "./dist/a432.kabbalah.cjs",
      "types": "./dist/a432.kabbalah.d.ts"
    },
    "./sacred-geometry": {
      "import": "./dist/a432.sacred.geometry.esm.js",
      "require": "./dist/a432.sacred.geometry.cjs",
      "types": "./dist/a432.sacred.geometry.d.ts"
    },
    "./electric-flow": {
      "import": "./dist/a432.electric.flow.esm.js",
      "require": "./dist/a432.electric.flow.cjs",
      "types": "./dist/a432.electric.flow.d.ts"
    },
    "./math-constants": {
      "import": "./dist/a432.math.constants.esm.js",
      "require": "./dist/a432.math.constants.cjs",
      "types": "./dist/a432.math.constants.d.ts"
    },
    "./wave-energy": {
      "import": "./dist/a432.wave.energy.esm.js",
      "require": "./dist/a432.wave.energy.cjs",
      "types": "./dist/a432.wave.energy.d.ts"
    },
    "./mobius-circuit": {
      "import": "./dist/a432.mobius.circuit.esm.js",
      "require": "./dist/a432.mobius.circuit.cjs",
      "types": "./dist/a432.mobius.circuit.d.ts"
    },
    "./a432-i": {
      "import": "./dist/a432.i.esm.js",
      "require": "./dist/a432.i.cjs",
      "types": "./dist/a432.i.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "src/**/*.json",
    "README.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "build:esm": "rollup -c --environment BUILD:esm",
    "build:types": "rollup -c --environment BUILD:types",
    "demo": "node dist/demo.js",
    "test": "node test-install.js",
    "test:kernel": "node --experimental-strip-types src/kernel/smoke.test.ts",
    "test:security": "node --experimental-strip-types src/security/quantum-fold-cipher.test.ts > /dev/null && node --experimental-strip-types src/security/quantum-state-tomography.test.ts > /dev/null && node --experimental-strip-types src/security/quantum-proofs.test.ts > /dev/null && node --experimental-strip-types src/security/post-quantum-crypto.test.ts > /dev/null && echo security tests ok",
    "test:quantum": "node --experimental-strip-types src/quantum/superposition-execution.test.ts > /dev/null && node --experimental-strip-types src/quantum/millennium-bridge.test.ts > /dev/null && node --experimental-strip-types src/quantum/zenodo-publisher.test.ts > /dev/null && echo quantum tests ok",
    "test:crypto": "node --experimental-strip-types src/crypto/ml-kem.test.ts > /dev/null && echo crypto tests ok",
    "test:verification": "node --experimental-strip-types src/verification/lean-bridge.test.ts > /dev/null && echo verification seals ok",
    "kat:ml-kem": "node --experimental-strip-types scripts/ml-kem-accumulated-kat.mjs",
    "registry:check": "node scripts/npm-registry-sync.mjs",
    "registry:apply": "node scripts/npm-registry-sync.mjs --apply",
    "registry:test": "node scripts/npm-registry-sync.mjs --self-test",
    "readme": "node --experimental-strip-types scripts/readme-gen.mjs",
    "readme:check": "node --experimental-strip-types scripts/readme-gen.mjs --check",
    "docs:pages": "node --experimental-strip-types scripts/docs-pages.mjs",
    "docs:pages:check": "node --experimental-strip-types scripts/docs-pages.mjs --check",
    "docs:index": "node scripts/docs-index.mjs",
    "docs:index:check": "node scripts/docs-index.mjs --check",
    "a432:scan": "node --experimental-strip-types scripts/a432-quantum-scan.mjs",
    "a432:scan:check": "node --experimental-strip-types scripts/a432-quantum-scan.mjs --check",
    "skills:seal": "node --experimental-strip-types scripts/skills-seal.mjs",
    "skills:check": "node --experimental-strip-types scripts/skills-seal.mjs --check",
    "version:seal": "node scripts/version-seal.mjs",
    "version:test": "node scripts/version-seal.test.mjs",
    "version:check": "node scripts/version-seal.mjs --check",
    "mcp": "node --experimental-strip-types src/mcp/server.ts",
    "mcp:smoke": "node --experimental-strip-types scripts/mcp-smoke.mjs",
    "self:next": "node --experimental-strip-types scripts/self-next.mjs",
    "quantum:sim": "node --experimental-strip-types scripts/quantum-sim.mjs",
    "tautology": "node scripts/facet-tautology.mjs",
    "math:ban": "node scripts/math-ban.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "hooks:install": "git config core.hooksPath .githooks && echo hooks:install ok",
    "verify:docs": "npm run version:check && npm run readme:check && npm run docs:pages:check && npm run a432:scan:check && npm run docs:index:check && npm run spectrum:check && npm run vortex:svg:check",
    "ratchet": "node scripts/ratchet.mjs",
    "ratchet:check": "node scripts/ratchet.mjs --check",
    "spectrum": "node --experimental-strip-types scripts/spectrum-gen.mjs",
    "spectrum:check": "node --experimental-strip-types scripts/spectrum-gen.mjs --check",
    "vortex:svg": "node --experimental-strip-types scripts/vortex-svg.mjs",
    "vortex:svg:check": "node --experimental-strip-types scripts/vortex-svg.mjs --check",
    "bundle:a432": "node scripts/build-a432-bundle.mjs",
    "bundle:a432:check": "node scripts/build-a432-bundle.mjs --check",
    "check": "npm run version:test && npm run registry:test && npm run version:check && npm run test:kernel && npm run test:security && npm run test:quantum && npm run test:crypto && npm run test:verification && npm run math:ban && npm run bundle:a432:check && npm run skills:seal && npm run skills:check && npm run readme && npm run readme:check && npm run docs:pages && npm run docs:pages:check && npm run a432:scan && npm run a432:scan:check && npm run docs:index && npm run docs:index:check && npm run spectrum && npm run spectrum:check && npm run vortex:svg && npm run vortex:svg:check && npm run docs:build && npm run quantum:sim && npm run ratchet:check && npm run mcp:smoke && npm run self:next",
    "prepublishOnly": "npm run build",
    "prose": "node scripts/prose-claims.mjs --list",
    "prose:check": "node scripts/prose-claims.mjs",
    "quantum:proof": "node --experimental-strip-types scripts/quantum-proof.mjs",
    "preversion": "npm run check",
    "version": "npm run version:seal && git add CITATION.cff README.md CHANGELOG.md",
    "postversion": "echo \"tagged v$npm_package_version — fill in the CHANGELOG entry if it is still a stub, then: git push --follow-tags\""
  },
